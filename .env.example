# Salin menjadi `.env`, lalu isi. Berkas `.env` TIDAK boleh masuk repositori.
#
#   cp .env.example .env
#
# Empat nilai teratas wajib: compose menolak menyala tanpa mereka, dan gateway
# sendiri juga menolak menyala dengan JWT secret yang kosong, terlalu pendek,
# atau masih memakai nilai contoh dari repositori.

# --- wajib -----------------------------------------------------------------

# Minimal 32 karakter acak (HS256 memakai kunci simetris; kunci lebih pendek
# menurunkan kekuatan tanda tangan ke panjang kuncinya, bukan ke algoritmanya).
# Menghasilkan nilai baru:
#   openssl rand -base64 48
#   pwsh: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# Database: PostgreSQL + TimescaleDB (image timescale/timescaledb:latest-pg16).
POSTGRES_PASSWORD=

# --- menjalankan API langsung di host (bukan lewat kontainer `api`) --------
#
# `docker compose up` menyuntikkan POSTGRES_PASSWORD di atas ke kontainer `api` sebagai
# ConnectionStrings__DefaultConnection dengan Host=db. `dotnet run --project Api` TIDAK
# membaca .env ini — appsettings.Development.json sengaja dikosongkan (lihat
# references/security.md, T1), jadi jalankan sekali dengan PASSWORD YANG SAMA persis
# seperti POSTGRES_PASSWORD di atas:
#
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" \
#     "Host=127.0.0.1;Port=5432;Database=db_synapse_iiot;Username=synapse_user;Password=<samakan dengan POSTGRES_PASSWORD>;" \
#     --project Api
#
# Host-nya beda (127.0.0.1 + port yang dipublikasikan, bukan nama servis `db`) karena
# proses host tidak ikut jaringan bridge compose; password-nya harus sama karena keduanya
# menyambung ke kontainer Postgres yang sama. Menyimpang di sini terlihat seperti bug
# ("password authentication failed"), padahal cuma dua sumber kredensial yang tidak
# disinkronkan. Perhatikan juga kata kunci Npgsql: `Host`/`Username`, BUKAN `Server`/`User`
# seperti MySQL — dua kata kunci MySQL itu tidak dikenal Npgsql.

# --- opsional (nilai baku ditulis di sebelah) ------------------------------

# POSTGRES_DB=db_synapse_iiot
# POSTGRES_USER=synapse_user
# POSTGRES_PORT=5432

# Port yang dipublikasikan ke host.
# API_PORT=5009
# WEB_PORT=8080
# MQTT_PORT=1883

# Origin UI — dipakai CORS dan pertahanan CSRF; harus sama persis dengan alamat
# yang dibuka di peramban, termasuk skema dan portnya.
# WEB_ORIGIN=http://localhost:8080

# Alamat gateway yang DILIHAT peramban. Nilai ini tertanam ke bundel saat build,
# jadi mengubahnya butuh `docker compose build web`, bukan sekadar restart.
# PUBLIC_API_URL=http://localhost:5009

# Produksi: Program.cs menolak menyala bila COOKIE_SECURE bukan true.
# ASPNETCORE_ENVIRONMENT=Production
# COOKIE_SECURE=true

# Penyetelan akuisisi.
# REALTIME_WINDOW_MS=250
# REPLAN_DEBOUNCE_MS=500
# HISTORIAN_BATCH_SIZE=500
